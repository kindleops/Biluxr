# ─────────────────────────────────────────────────────────────────────────────
# Biluxr environment. Copy to .env.local and fill in what you have.
# Nothing is required to run the site: without credentials the product shows
# honest "not yet available" states. See docs/ARCHITECTURE.md → "Data modes".
# ─────────────────────────────────────────────────────────────────────────────

# Public origin, used for canonical URLs, sitemap, OG and magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Demo mode ────────────────────────────────────────────────────────────────
# Fictional fixtures in an in-memory store. Ignored when Supabase is configured
# and refused on Vercel production deployments (VERCEL_ENV=production).
BILUXR_DEMO_MODE=false

# ── Supabase (database, auth, row-level security) ────────────────────────────
# Project Settings → API. The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for: AI event logging on member requests, sign-in
# eligibility (approved applicants), analytics inserts. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Biluxr AI (Claude) ───────────────────────────────────────────────────────
# console.anthropic.com → API keys. Without it, AI features show as unavailable.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
BILUXR_AI_MODEL=

# ── Analytics ────────────────────────────────────────────────────────────────
# Random 32+ character secret used to hash user ids in analytics events.
# Without it, events are stored without a subject.
BILUXR_ANALYTICS_SALT=

# ── Payments (not yet integrated; boundary only) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
